# Vite Environment Configuration
# Local backend: http://localhost:8000/api/v1 | Production backend: https://<your-backend-domain>/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# =========================================================================
# CLOUDFLARE R2 OBJECT STORAGE (S3-COMPATIBLE)
# =========================================================================
# Cloudflare Dashboard -> R2 Overview -> Account ID
R2_ACCOUNT_ID=your_cloudflare_account_id_here
# R2 -> Manage R2 API Tokens -> Create API Token (Permissions: Object Read & Write)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
# Bucket Name in Cloudflare R2
R2_BUCKET_NAME=hotel-sai-vasudev-documents
# Optional Public Domain (e.g. https://pub-xxx.r2.dev or custom CDN https://media.saivasudev.com)
R2_PUBLIC_DOMAIN=
# Optional Public URL for client-side direct access (if public bucket enabled)
VITE_R2_PUBLIC_URL=
