# Railway automatically populates DATABASE_URL when you add a PostgreSQL plugin.
# Example format:
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:54321/railway

DATABASE_URL=sqlite:///./hotel_sai_vasudev.db
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://hotel-sai-vasudev-residency.pages.dev
