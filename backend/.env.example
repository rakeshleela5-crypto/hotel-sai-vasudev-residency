# Database Configuration (Railway automatically populates DATABASE_URL when PostgreSQL is attached)
# Example format: postgresql://postgres:password@roundhouse.proxy.rlwy.net:54321/railway
DATABASE_URL=sqlite:///./hotel_sai_vasudev.db
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://hotel-sai-vasudev-residency.pages.dev

# =========================================================================
# DECENTRO BANKING & KYC API CREDENTIALS
# =========================================================================
# Staging Base URL: https://in.staging.decentro.tech
# Production Base URL: https://in.decentro.tech
DECENTRO_BASE_URL=https://in.staging.decentro.tech
DECENTRO_CLIENT_ID=your_decentro_client_id_here
DECENTRO_CLIENT_SECRET=your_decentro_client_secret_here
DECENTRO_PAYMENT_SECRET=your_decentro_payment_module_secret_here
DECENTRO_KYC_SECRET=your_decentro_kyc_module_secret_here
DECENTRO_WEBHOOK_SECRET=your_decentro_webhook_signature_secret_here
DECENTRO_PAYEE_ACCOUNT=your_hotel_master_virtual_account_or_upi_id

# =========================================================================
# CLOUDFLARE R2 OBJECT STORAGE (S3-COMPATIBLE)
# =========================================================================
# Cloudflare Dashboard -> R2 Overview -> Account ID
R2_ACCOUNT_ID=your_cloudflare_account_id_here
# R2 -> Manage R2 API Tokens -> Create API Token (Permissions: Object Read & Write)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
# Bucket Name in Cloudflare R2
R2_BUCKET_NAME=hotel-sai-vasudev-documents
# Optional Public Domain (e.g., https://pub-xxx.r2.dev or custom CDN https://media.saivasudev.com)
R2_PUBLIC_DOMAIN=
